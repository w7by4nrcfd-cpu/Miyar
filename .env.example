# انسخ هذا الملف إلى .env ثم ضع القيم. لا تضع أي مفتاح حقيقي في المستودع.
# في Claude Code على الويب: تُضاف القيم في إعدادات البيئة (Edit) كمتغيرات بيئة، لا في الكود.

# --- نموذج مِعيار (miyar/llm.py) ---
# المنفّذ حالياً: gemini فقط. (anthropic وواجهات OpenAI المتوافقة: تُضاف عند الحاجة)
MIYAR_LLM_PROVIDER=gemini
# نموذجا الدورين (مثبّتان في 2026-10-01): الحَكَم والمساعد المُختبَر نموذجان مختلفان عمداً
# لتجنب تحيّز النموذج لإجاباته. (gemini-2.5-flash و-flash-lite أعادا 404 «غير متاح للمستخدمين الجدد».)
MIYAR_LLM_MODEL_JUDGE=gemini-3.8-flash
MIYAR_LLM_MODEL_ASSISTANT=gemini-3.5-flash-lite
# احتياط الحَكَم وحده: عند 503 أو 429 بعد 3 محاولات بتأخير تصاعدي (2ث، 4ث) يُجرَّب هذا النموذج.
# كل نتيجة تسجّل النموذج الذي أجاب فعلاً (model) لا المطلوب فقط (requested_model).
MIYAR_LLM_MODEL_JUDGE_FALLBACK=gemini-3.5-flash
# سقف رموز الحَكَم 1024 على الأقل مع تفكير منخفض (thinkingLevel=low لعائلة Gemini 3، وthinkingBudget=256 لعائلة 2.5)
# مثبّتان في miyar/llm.py (JUDGE_MIN_OUTPUT_TOKENS وJUDGE_THINKING). الإجابة الفارغة أو MAX_TOKENS لا تُخزَّن أبداً.
# احتياطي لأي دور لم يُضبط متغيره (بلا قيمة افتراضية عمداً)
MIYAR_LLM_MODEL=
GEMINI_API_KEY=

# --- عتبة الثقة: أقل منها تُحال الحالة إلى مراجعة بشرية (تُستخدم في أيام التحدي) ---
MIYAR_JUDGE_MIN_CONFIDENCE=0.75

# --- وضع التشغيل (يحمي رابط التحكيم من نفاد الرصيد) ---
# cached: يعيد الاستجابات المحفوظة فقط ولا يستدعي أي نموذج (افتراضي)
# live:   يستدعي النموذج لما لم يُحفظ بعد، بالسقف اليومي أدناه؛ ولا يكرر استدعاءً أُجري
MIYAR_RUN_MODE=cached
MIYAR_LIVE_MAX_CALLS_PER_DAY=10

# --- مخزن الاستجابات ووسم التشغيل ---
# تشغيلات التطوير تُحفظ في evaluation/dev/ وتحمل الوسم DEV_RUN، ولا تُنشر كنتائج.
MIYAR_LLM_CACHE_DIR=evaluation/dev/llm_cache
MIYAR_RUN_LABEL=DEV_RUN

# --- التخزين ---
MIYAR_DATA_DIR=data
