# انسخ هذا الملف إلى .env ثم ضع القيم. لا تضع أي مفتاح حقيقي في المستودع.

# --- نموذج مِعيار الداخلي (الاستخراج والحكم) ---
# anthropic | openai_compatible
MIYAR_LLM_PROVIDER=anthropic
MIYAR_LLM_MODEL=
ANTHROPIC_API_KEY=
# لأي واجهة متوافقة مع OpenAI
OPENAI_COMPATIBLE_BASE_URL=
OPENAI_COMPATIBLE_API_KEY=

# --- عتبة الثقة: أقل منها تُحال الحالة إلى مراجعة بشرية ---
MIYAR_JUDGE_MIN_CONFIDENCE=0.75

# --- التخزين ---
MIYAR_DATA_DIR=data
MIYAR_DB_PATH=miyar.sqlite
