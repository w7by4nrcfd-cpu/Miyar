{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/w7by4nrcfd-cpu/Miyar/web/data/results.schema.json",
  "title": "نتائج تشغيلات مِعيار",
  "description": "ملف web/data/results.json. لا يُكتب فيه إلا ناتج تشغيل فعلي مسجّل في evaluation/. قائمة runs الفارغة = «لم يُشغَّل أي اختبار بعد».",
  "type": "object",
  "required": [
    "schema_version",
    "runs"
  ],
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": 1
    },
    "runs": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/run"
      }
    },
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "rule",
        "reference_run_id",
        "candidate_run_id",
        "allow",
        "reasons"
      ],
      "description": "قرار البوابة من scoring.gate_decision: المرشحة آخر تشغيل rag، والمرجع آخر تشغيل baseline. يغيب إن غاب أحدهما.",
      "properties": {
        "rule": {
          "type": "string",
          "minLength": 1
        },
        "reference_run_id": {
          "type": "string",
          "minLength": 1
        },
        "candidate_run_id": {
          "type": "string",
          "minLength": 1
        },
        "allow": {
          "type": "boolean"
        },
        "reasons": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      }
    },
    "stability": {
      "type": "object",
      "description": "الثبات لكل مساعد له تشغيلان رسميان أو أكثر (scoring.stability): أعلى وأدنى وفرق لكل مستوى. لا يُختار أفضل تشغيل.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "run_ids",
          "overall",
          "levels"
        ]
      }
    }
  },
  "$defs": {
    "run": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "run_id",
        "executed_at",
        "assistant",
        "model",
        "testset",
        "n_cases",
        "overall_score",
        "levels",
        "wrong_citations",
        "human_reviewed",
        "evaluation_record"
      ],
      "properties": {
        "run_id": {
          "type": "string",
          "minLength": 1,
          "description": "معرّف فريد للتشغيل"
        },
        "executed_at": {
          "type": "string",
          "format": "date-time",
          "description": "وقت التشغيل الفعلي (ISO 8601)"
        },
        "assistant": {
          "type": "string",
          "minLength": 1,
          "description": "المساعد المُختبَر، مثل baseline أو rag"
        },
        "model": {
          "type": "string",
          "minLength": 1,
          "description": "اسم النموذج وإصداره كما استُدعي فعلاً"
        },
        "testset": {
          "type": "string",
          "minLength": 1,
          "description": "مجموعة الاختبار، مثل official_v0"
        },
        "n_cases": {
          "type": "integer",
          "minimum": 1,
          "description": "عدد الحالات N"
        },
        "overall_score": {
          "type": "number",
          "minimum": 0,
          "maximum": 100,
          "description": "الدرجة الكلية (0–100)"
        },
        "levels": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "A",
            "B",
            "C",
            "D"
          ],
          "description": "درجة كل مستوى؛ مجموع n_cases للمستويات = n_cases الكلي",
          "properties": {
            "A": {
              "type": "object",
              "required": [
                "n_cases",
                "score"
              ],
              "additionalProperties": false,
              "properties": {
                "n_cases": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات هذا المستوى"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "درجة المستوى (0–100)؛ null إذا لم تكن فيه حالات أو لم تُحتسب منه أي حالة (n_scored = 0)"
                },
                "n_scored": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات المستوى المحتسبة في الدرجة (غير المحالة إلى مراجعة بشرية وغير المتعذّرة)"
                }
              }
            },
            "B": {
              "type": "object",
              "required": [
                "n_cases",
                "score"
              ],
              "additionalProperties": false,
              "properties": {
                "n_cases": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات هذا المستوى"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "درجة المستوى (0–100)؛ null إذا لم تكن فيه حالات أو لم تُحتسب منه أي حالة (n_scored = 0)"
                },
                "n_scored": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات المستوى المحتسبة في الدرجة (غير المحالة إلى مراجعة بشرية وغير المتعذّرة)"
                }
              }
            },
            "C": {
              "type": "object",
              "required": [
                "n_cases",
                "score"
              ],
              "additionalProperties": false,
              "properties": {
                "n_cases": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات هذا المستوى"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "درجة المستوى (0–100)؛ null إذا لم تكن فيه حالات أو لم تُحتسب منه أي حالة (n_scored = 0)"
                },
                "n_scored": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات المستوى المحتسبة في الدرجة (غير المحالة إلى مراجعة بشرية وغير المتعذّرة)"
                }
              }
            },
            "D": {
              "type": "object",
              "required": [
                "n_cases",
                "score"
              ],
              "additionalProperties": false,
              "properties": {
                "n_cases": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات هذا المستوى"
                },
                "score": {
                  "type": [
                    "number",
                    "null"
                  ],
                  "minimum": 0,
                  "maximum": 100,
                  "description": "درجة المستوى (0–100)؛ null إذا لم تكن فيه حالات أو لم تُحتسب منه أي حالة (n_scored = 0)"
                },
                "n_scored": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "عدد حالات المستوى المحتسبة في الدرجة (غير المحالة إلى مراجعة بشرية وغير المتعذّرة)"
                }
              }
            }
          }
        },
        "wrong_citations": {
          "type": "integer",
          "minimum": 0,
          "description": "عدد الإسنادات المصنّفة wrong_or_missing"
        },
        "human_reviewed": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "approved",
            "total",
            "by_role"
          ],
          "description": "المراجعة البشرية: approved ≤ total، وtotal = n_cases، وapproved = by_role.specialist + by_role.source_check. source_check تحقق من المصادر بواسطة المشارك وليس مراجعة شرعية متخصصة، ويُعرض منفصلاً.",
          "properties": {
            "approved": {
              "type": "integer",
              "minimum": 0
            },
            "total": {
              "type": "integer",
              "minimum": 0
            },
            "by_role": {
              "type": "object",
              "additionalProperties": false,
              "required": [
                "specialist",
                "source_check"
              ],
              "description": "عدد الحالات المقبولة لكل نوع مراجعة",
              "properties": {
                "specialist": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "مراجعة شرعية متخصصة"
                },
                "source_check": {
                  "type": "integer",
                  "minimum": 0,
                  "description": "تحقق من المصادر بواسطة المشارك — ليس مراجعة شرعية متخصصة"
                }
              }
            }
          }
        },
        "evaluation_record": {
          "type": "string",
          "pattern": "^evaluation/official/(?!(.*/)?\\.\\.(/|$)).+",
          "description": "مسار سجل التشغيل الرسمي (OFFICIAL_RUN) داخل evaluation/official/ وحده؛ أي مسار خارجه مرفوض"
        },
        "n_scored": {
          "type": "integer",
          "minimum": 0,
          "description": "عدد الحالات المحتسبة في الدرجة الكلية"
        },
        "human_review_needed": {
          "type": "integer",
          "minimum": 0,
          "description": "حالات أحالها الحَكَم الآلي إلى مراجعة بشرية (ثقة منخفضة أو إخراج غير صالح أو مدخل يدوي ناقص)"
        },
        "referral": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "passed",
            "failed",
            "undecided"
          ],
          "description": "فحص الإحالة إلى مختص (refer_to_qualified) في الحالات التي تتطلبه",
          "properties": {
            "passed": {
              "type": "integer",
              "minimum": 0
            },
            "failed": {
              "type": "integer",
              "minimum": 0
            },
            "undecided": {
              "type": "integer",
              "minimum": 0
            }
          }
        }
      }
    }
  }
}
